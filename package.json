{
	"name": "seedbed",
	"version": "0.8.2",
	"description": "Grow ideas from seed to mature through thinking gates (Socratic, Devil's Advocate, Feynman).",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test:live": "vitest run --config vitest.live.config.ts",
		"install-test-vault": "node scripts/install-to-test-vault.mjs",
		"gen-test-vault": "node scripts/gen-test-vault.mjs",
		"check-integrity": "node scripts/check-integrity.mjs"
	},
	"keywords": [
		"obsidian",
		"plugin"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.5.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.72.2",
		"vite": "6.4.6",
		"vitest": "5.1.0",
		"yaml": "^2.9.1"
	}
}
