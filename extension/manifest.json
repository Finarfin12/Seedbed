{
	"manifest_version": 3,
	"name": "__MSG_extName__",
	"description": "__MSG_extDescription__",
	"version": "0.2.0",
	"default_locale": "en",
	"minimum_chrome_version": "114",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"permissions": [
		"contextMenus",
		"storage",
		"activeTab",
		"scripting"
	],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_title": "__MSG_actionTitle__",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png"
		}
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"commands": {
		"capture-selection": {
			"suggested_key": {
				"default": "Alt+Shift+S"
			},
			"description": "__MSG_cmdCapture__"
		}
	}
}
